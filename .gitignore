!raw/**/.gitkeep

# Personal plans and Obsidian workspace settings stay local.
planner/
.obsidian/
.trash/

# Local AI instructions
/AGENTS.md
/prompts/

# Secrets
.env
.env.*
!.env.example

# Temporary and OS files
*.log
.DS_Store
Thumbs.db

